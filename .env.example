# ==============================================================================
# TikTok Autopilot 24/7 — Variables d'Environnement & Secrets GitHub Actions
# Copiez ce fichier vers `.env` en local (ne jamais commiter `.env`)
# ou configurez ces clés dans GitHub : Settings > Secrets and variables > Actions
# ==============================================================================

# 1. Authentification TikTok Studio Web (Playwright — Méthode Principale)
# Export JSON de vos cookies TikTok Studio via l'extension Cookie-Editor
# ou valeur directe du cookie `sessionid`.
TIKTOK_SESSION_ID=""

# 2. Authentification API Officielle TikTok Content Posting API v2 (Optionnel)
TIKTOK_ACCESS_TOKEN=""

# 3. Notifications Instantanées (Optionnel : Discord Webhook ou Telegram Bot API)
# Exemple Discord : https://discord.com/api/webhooks/xxx/yyy
# Exemple Telegram : https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>
TIKTOK_WEBHOOK_URL=""
TELEGRAM_CHAT_ID=""

# 4. Contournement Réseau YouTube Source (Optionnel)
# Contenu Netscape cookies.txt ou chemin local vers le fichier cookies
YOUTUBE_COOKIES_FILE=""
YT_DLP_PROXY=""

# 5. Paramètres d'Exécution Autopilot (Optionnel)
PUBLISH_MODE="public"
FORCE_VIDEO_ID=""
